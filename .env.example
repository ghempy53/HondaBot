# =============================================================================
# HondaBot - Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit your .env file to version control!
# =============================================================================

# Discord Bot Configuration (Required)
# Get these from: https://discord.com/developers/applications
RPP_DISCORD_CLIENT_ID=your_client_id_here
RPP_DISCORD_TOKEN=your_bot_token_here
RPP_DISCORD_USERNAME=your_discord_username

# Battlemetrics (Optional)
# Tracker features and the /players command work fine WITHOUT a token -- the
# public server/player/leaderboard endpoints serve unauthenticated at 60 req/min
# and 15 req/sec, which is well clear of this bot's once-per-minute polling.
#
# A token only raises those ceilings to 300/min and 45/sec. BattleMetrics limits
# Personal Access Tokens to paid subscribers, so leave this blank unless you
# already have a subscription. If you do set it, paste the raw JWT only -- the
# "Bearer " prefix is added in code.
# RPP_BATTLEMETRICS_TOKEN=

# Set to false to turn off all Battlemetrics features (trackers, /players,
# server BM info). Defaults to enabled.
# RPP_BATTLEMETRICS_ENABLED=false

# Timezone (Optional)
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=UTC

# =============================================================================
# Advanced Settings (Usually don't need to change)
# =============================================================================

# Node.js memory limit (in MB)
# Adjust based on your Raspberry Pi model:
# - Pi 4 1GB: 512
# - Pi 4 2GB: 768
# - Pi 4 4GB: 1024 (default)
# - Pi 4 8GB: 2048
# NODE_MAX_MEMORY=1024
